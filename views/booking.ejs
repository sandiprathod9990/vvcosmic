<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/seo-head', { site, services, seo }) %>
</head>
<body class="booking-page">
  <header class="site-header site-header--minimal" id="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">VV<span class="logo-accent">Cosmic</span></a>
      <a href="/" class="nav-back">Return</a>
    </div>
  </header>

  <main class="booking-main">
    <div class="container booking-container">
      <div class="booking-intro reveal">
        <%- include('partials/lotus-icon', { lotusClass: 'lotus-icon lotus-icon--section' }) %>
        <span class="section-label">Consultation Inquiry</span>
        <h1>Begin the conversation</h1>
        <p>Share your context with intention. <%= site.practitioner %> reviews each inquiry personally. Meaningful guidance often continues through WhatsApp after initial contact.</p>
        <p class="inquiry-flow">Inquiry → Initial context → Consultation discussion → Private guidance</p>
      </div>

      <form id="inquiry-form" class="booking-form inquiry-form" novalidate>
        <div class="form-grid">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name">
          </div>
          <div class="form-group">
            <label for="country">Country</label>
            <input type="text" id="country" name="country" required placeholder="Your country">
          </div>
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com">
          </div>
          <div class="form-group">
            <label for="whatsapp">WhatsApp Number</label>
            <input type="tel" id="whatsapp" name="whatsapp" required autocomplete="tel" placeholder="+91 …">
          </div>
          <div class="form-group form-group--full">
            <label for="concern">Area of Concern</label>
            <input type="text" id="concern" name="concern" required placeholder="Career, relationships, environment, patterns…">
          </div>
          <div class="form-group form-group--full">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" required placeholder="Share what you are navigating and what clarity would mean for you."></textarea>
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary" id="submit-inquiry">Submit Inquiry</button>
        </div>
      </form>

      <div id="inquiry-success" class="booking-success hidden">
        <div class="success-content">
          <span class="section-label">Inquiry Received</span>
          <h2>Thank you.</h2>
          <p>Your inquiry has been received. We will review your context personally and respond within 48 hours.</p>
          <p class="success-id">Reference: <span id="inquiry-ref"></span></p>
          <a href="/" class="btn btn-primary">Return Home</a>
        </div>
      </div>
    </div>
  </main>

  <script src="/js/booking.js" defer></script>
  <script src="/js/main.js" defer></script>
</body>
</html>
