<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/seo-head', { site, services, seo }) %>
</head>
<body>
  <div class="nav-overlay" id="nav-overlay" aria-hidden="true"></div>
  <div class="site-top" id="site-top">
    <div class="container site-top-inner">
      <header class="site-header" id="site-header">
        <div class="header-inner">
          <a href="/" class="logo-link" aria-label="<%= site.name %> home"><%- include('partials/logo') %></a>
          <div class="header-actions">
            <a href="tel:<%= site.phone.replace(/\s/g, '') %>" class="header-phone"><%= site.phoneDisplay %></a>
            <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="primary-nav">
              <span></span><span></span>
            </button>
          </div>
        </div>
      </header>
      <nav class="nav" aria-label="Primary" id="primary-nav">
        <a href="#philosophy">Philosophy</a>
        <a href="#life-architecture">Architecture</a>
        <a href="#astrology">Astrology</a>
        <a href="#vastu">Vastu</a>
        <a href="#thought-speech-action">Alignment</a>
        <a href="#the-practice">Practice</a>
        <a href="tel:<%= site.phone.replace(/\s/g, '') %>" class="nav-phone"><%= site.phoneDisplay %></a>
        <a href="/booking" class="nav-cta">Inquiry</a>
      </nav>
    </div>
  </div>

  <main>
    <!-- Hero -->
    <section class="hero hero--dark section-centered" id="hero" aria-labelledby="hero-heading">
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-lotus-bg"><%- include('partials/hero-lotus') %></div>
      </div>
      <div class="container hero-inner">
        <p class="hero-eyebrow reveal"><%= site.practitioner %></p>
        <h1 class="hero-title reveal" id="hero-heading">Hidden patterns shape visible life.<br>Observation precedes alignment.</h1>
        <p class="hero-subtitle reveal">A private advisory practice studying life architecture — chart, behavior, environment, and the recurring structures beneath what you see.</p>
        <p class="hero-depth reveal">This is not prediction. It is perception — pattern recognition, spatial intelligence, and strategic refinement.</p>
        <div class="hero-actions reveal">
          <a href="/booking" class="btn btn-primary">Begin the Conversation</a>
          <a href="#philosophy" class="btn btn-ghost-light">Explore the Approach</a>
        </div>
      </div>
    </section>

    <%- include('partials/section-divider') %>

    <!-- Philosophy -->
    <section class="section section--light section-centered" id="philosophy" aria-labelledby="philosophy-heading">
      <div class="container">
        <%- include('partials/lotus-icon', { lotusClass: 'lotus-icon lotus-icon--section' }) %>
        <span class="section-label reveal">Philosophy</span>
        <h2 class="reveal" id="philosophy-heading">Patterns repeat until they are seen clearly</h2>
        <p class="section-lead reveal">The work begins with observation — recurring themes, karmic tendencies, behavioral loops, environmental influence, and the structures that shape how life unfolds.</p>
        <div class="philosophy-pillars reveal">
          <p>Recurring patterns · Awareness · Karmic tendencies · Behavioral loops · Environment · Alignment</p>
        </div>
        <blockquote class="philosophy-quote reveal">
          <p>Karma is not a verdict. It is the pattern beneath the pattern — and awareness is how repetition becomes choice.</p>
        </blockquote>
      </div>
    </section>

    <%- include('partials/section-divider') %>

    <!-- Life Architecture -->
    <section class="section section--stone section-centered" id="life-architecture" aria-labelledby="architecture-heading">
      <div class="container container--narrow">
        <%- include('partials/lotus-icon', { lotusClass: 'lotus-icon lotus-icon--section' }) %>
        <span class="section-label reveal">Life Architecture</span>
        <h2 class="reveal" id="architecture-heading">The intellectual center of the practice</h2>
        <p class="section-lead reveal">Visible outcomes — career, relationships, inner life — are shaped by structures operating beneath conscious awareness.</p>
        <p class="reveal">Life architecture maps how behavior, environment, thought patterns, and recurring tendencies intersect. The goal is integrated understanding — why certain patterns persist, not more information.</p>
        <ul class="centered-list reveal">
          <li>Behavior and routine</li>
          <li>Environmental influence</li>
          <li>Thought and speech habits</li>
          <li>Recurring life themes</li>
        </ul>
      </div>
    </section>

    <%- include('partials/section-divider') %>

    <!-- Astrology -->
    <section class="section section--dark section-centered" id="astrology" aria-labelledby="astrology-heading">
      <div class="container container--narrow">
        <%- include('partials/lotus-icon', { lotusClass: 'lotus-icon lotus-icon--section' }) %>
        <span class="section-label reveal">Astrology</span>
        <h2 class="reveal" id="astrology-heading">Symbolic language, not prediction</h2>
        <p class="section-lead reveal">Astrology is approached as pattern recognition — a map of tendencies, recurring themes, and periods of emphasis. Intelligent, observational, modern.</p>
        <p class="reveal">The chart does not dictate fate. It reveals structure — what repeats, what seeks balance, and where awareness can refine expression.</p>
      </div>
    </section>

  <!-- How I Practice Astrology -->
    <section class="section section--light section-centered" id="astrology-method" aria-labelledby="astrology-method-heading">
      <div class="container">
        <span class="section-label reveal">How I Practice Astrology</span>
        <h2 class="reveal" id="astrology-method-heading">A layered observational process</h2>
        <div class="process-timeline">
          <article class="timeline-step reveal">
            <span class="timeline-num">01</span>
            <h3>Pattern Observation</h3>
            <p>Understanding the chart, personal experiences, recurring themes, and emotional tendencies — before any conclusion.</p>
            <ul>
              <li>Birth chart & planetary periods</li>
              <li>Recurring life themes</li>
              <li>Emotional & behavioral observation</li>
            </ul>
          </article>
          <article class="timeline-step reveal timeline-step--featured">
            <span class="timeline-num">02</span>
            <h3>Lifestyle & Root Cause Analysis</h3>
            <p>Understanding why patterns repeat — routines, thought patterns, speech habits, emotional cycles, behavioral tendencies.</p>
            <ul>
              <li>Daily rhythm & routine</li>
              <li>Thought & speech habits</li>
              <li>Emotional cycles</li>
            </ul>
          </article>
          <article class="timeline-step reveal">
            <span class="timeline-num">03</span>
            <h3>Alignment & Strategic Correction</h3>
            <p>Creating awareness, refinement, practical change, and deeper alignment across how you live.</p>
            <ul>
              <li>Thought, speech & action</li>
              <li>Behavioral recalibration</li>
              <li>Strategic guidance</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <%- include('partials/section-divider') %>

    <!-- Vastu -->
    <section class="section section--light section-centered" id="vastu" aria-labelledby="vastu-heading">
      <div class="container">
        <%- include('partials/lotus-icon', { lotusClass: 'lotus-icon lotus-icon--section' }) %>
        <span class="section-label reveal">Vastu</span>
        <h2 class="reveal" id="vastu-heading">Spatial intelligence</h2>
        <p class="section-lead reveal">Environmental psychology and energetic architecture — how layout, light, flow, and space influence clarity, movement, and behavior.</p>
        <p class="reveal">No fear-based language. Focus on clarity, environment, and the influence of surroundings on decision-making and inner state.</p>
        <figure class="blueprint-figure reveal">
          <img src="/images/vastu-purusha-blueprint.jpg" alt="Spatial intelligence — Purusha Mandala architectural diagram" width="1024" height="682" loading="lazy" decoding="async">
        </figure>
      </div>
    </section>

    <!-- How I Practice Vastu -->
    <section class="section section--stone section-centered section--geometric" id="vastu-method" aria-labelledby="vastu-method-heading">
      <div class="container">
        <span class="section-label reveal">How I Practice Vastu</span>
        <h2 class="reveal" id="vastu-method-heading">Structured spatial methodology</h2>
        <div class="process-timeline process-timeline--vertical">
          <article class="timeline-step reveal">
            <span class="timeline-num">01</span>
            <h3>Spatial Observation</h3>
            <p>Reading the living or working environment — layout, movement, light, and flow.</p>
          </article>
          <article class="timeline-step reveal">
            <span class="timeline-num">02</span>
            <h3>Environmental Analysis</h3>
            <p>Understanding environmental friction, energy flow, and how space shapes behavior and clarity.</p>
          </article>
          <article class="timeline-step reveal">
            <span class="timeline-num">03</span>
            <h3>Strategic Refinement</h3>
            <p>Practical corrections — layout, placement, and adjustments integrated into daily life.</p>
          </article>
        </div>
      </div>
    </section>

    <%- include('partials/section-divider') %>

    <!-- Thought • Speech • Action -->
    <section class="section section--dark section-centered" id="thought-speech-action" aria-labelledby="tsa-heading">
      <div class="container container--narrow">
        <%- include('partials/lotus-icon', { lotusClass: 'lotus-icon lotus-icon--section' }) %>
        <span class="section-label reveal">Thought · Speech · Action</span>
        <h2 class="reveal" id="tsa-heading">Meaningful transformation occurs across every layer</h2>
        <p class="section-lead reveal">A modern interpretation of alignment through mind, word, and deed — integrated with environment.</p>
        <div class="tsa-pillars reveal">
          <div class="tsa-pillar"><h3>Thought</h3><p>Inner narratives and mental patterns</p></div>
          <div class="tsa-pillar"><h3>Speech</h3><p>How language shapes reality</p></div>
          <div class="tsa-pillar"><h3>Action</h3><p>Daily choices that embody awareness</p></div>
          <div class="tsa-pillar"><h3>Environment</h3><p>Space as extension of behavior</p></div>
        </div>
      </div>
    </section>

    <!-- What Changes? -->
    <section class="section section--light section-centered" id="what-changes" aria-labelledby="changes-heading">
      <div class="container">
        <span class="section-label reveal">What Changes?</span>
        <h2 class="reveal" id="changes-heading">Outcomes clients describe</h2>
        <ul class="outcomes-grid reveal">
          <li>Clearer decisions</li>
          <li>Reduced confusion</li>
          <li>Greater awareness</li>
          <li>Stronger alignment</li>
          <li>Emotional stability</li>
          <li>Improved relationship with environment</li>
          <li>More intentional living</li>
        </ul>
      </div>
    </section>

    <%- include('partials/section-divider') %>

    <!-- The Practice -->
    <section class="section section--stone section-centered" id="the-practice" aria-labelledby="practice-heading">
      <div class="container container--narrow">
        <%- include('partials/lotus-icon', { lotusClass: 'lotus-icon lotus-icon--section' }) %>
        <span class="section-label reveal">The Practice</span>
        <h2 class="reveal" id="practice-heading">Methodology before recommendation</h2>
        <p class="section-lead reveal">This is not biography. It is how the practice differs from ordinary consultations.</p>
        <p class="reveal">Before any guidance is offered, the practice studies chart, behavior, environment, routine, emotional cycles, and recurring life themes. Observation is deliberate. Recommendations follow understanding.</p>
      </div>
    </section>

    <!-- Reflections -->
    <section class="section section--light section-centered" id="reflections" aria-labelledby="reflections-heading">
      <div class="container">
        <span class="section-label reveal">Reflections</span>
        <h2 class="reveal" id="reflections-heading">What clients describe</h2>
        <div class="testimonial-stack">
          <% testimonials.forEach(function(t) { %>
          <blockquote class="testimonial reveal">
            <p>"<%= t.quote %>"</p>
            <footer><cite>— <%= t.cite %></cite><span><%= t.theme %></span></footer>
          </blockquote>
          <% }); %>
        </div>
      </div>
    </section>

    <!-- Inquiry CTA -->
    <section class="section section--dark section-centered" id="inquiry" aria-labelledby="inquiry-heading">
      <div class="container container--narrow">
        <%- include('partials/lotus-icon', { lotusClass: 'lotus-icon lotus-icon--section' }) %>
        <span class="section-label reveal">Consultation Inquiry</span>
        <h2 class="reveal" id="inquiry-heading">Begin the conversation</h2>
        <p class="section-lead reveal">Inquiry · Initial context · Consultation discussion · Private guidance. Each request is reviewed personally.</p>
        <a href="/booking" class="btn btn-primary reveal">Submit Inquiry</a>
      </div>
    </section>
  </main>

  <footer class="site-footer site-footer--book">
    <div class="container footer-book">
      <%- include('partials/lotus-icon', { lotusClass: 'lotus-icon lotus-icon--footer-large' }) %>
      <p class="footer-quote">"<%= site.footerQuote %>"</p>
      <p class="footer-practitioner"><%= site.practitioner %> · <%= site.name %></p>
      <nav class="footer-minimal" aria-label="Footer">
        <a href="mailto:<%= site.email %>"><%= site.email %></a>
        <span aria-hidden="true">·</span>
        <a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phoneDisplay %></a>
        <span aria-hidden="true">·</span>
        <a href="/booking">Inquiry</a>
      </nav>
      <p class="footer-copy">&copy; <%= new Date().getFullYear() %> <%= site.name %></p>
    </div>
  </footer>

  <script src="/js/main.js" defer></script>
</body>
</html>
