<%#
  Section background image + dark overlay
  Params: image (required), bgClass, position, size
%>
<div class="section-bg" aria-hidden="true">
  <div
    class="section-bg__image<%= typeof bgClass !== 'undefined' ? ' ' + bgClass : '' %>"
    style="background-image: url('<%= image %>');<% if (typeof position !== 'undefined') { %> background-position: <%= position %>;<% } %><% if (typeof size !== 'undefined') { %> background-size: <%= size %>;<% } %>"
  ></div>
  <div class="section-bg__overlay"></div>
</div>
