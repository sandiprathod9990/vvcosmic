<% const showLeft = typeof carvingLeft === 'undefined' ? true : carvingLeft; %>
<% const showRight = typeof carvingRight === 'undefined' ? false : carvingRight; %>
<% if (showLeft) { %>
<div class="carving-accent carving-accent--left" aria-hidden="true"></div>
<% } %>
<% if (showRight) { %>
<div class="carving-accent carving-accent--right" aria-hidden="true"></div>
<% } %>
